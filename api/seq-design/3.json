                        "Same as previous",
                        "Same as previous",
                        "No change"
                    ],
                    [
                        "1",
                        "0",
                        "0",
                        "Same as previous",
                        "Same as previous",
                        "No change"
                    ],
                    [
                        "1",
                        "0",
                        "1",
                        "0",
                        "1",
                        "Reset"
                    ],
                    [
                        "1",
