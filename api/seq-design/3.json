            "content": "Introduction",
            "scrollToId": 0
        },
        {
            "type": "text",
            "size": "H3",
            "content": "Before getting into the race around condition, let us have a look at the JK flip-flop's truth table."
        },
        {
            "type": "widget",
            "sub_type": "table",
            "content": {
                "heading": [
                    "Clock Input",
                    "Inputs",
                    "",
                    "Outputs",
                    "",
                    "Comments"
                ],
                "rows": [
                    [
                        "",
                        "J",
                        "K",
                        "Q",
                        "Q'",
                        ""
                    ],
                    [
                        "0",
