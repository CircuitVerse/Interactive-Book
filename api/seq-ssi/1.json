                    "J",
                    "K",
                    "Q(t+1)"
                ],
                "rows": [
                    [
                        "0",
                        "0",
                        "Q(t)"
                    ],
                    [
                        "0",
                        "1",
                        "0"
                    ],
                    [
                        "1",
                        "0",
                        "1"
                    ],
                    [
                        "1",
                        "1",
                        "Q(t)'"
                    ]
                ]
            }
        },
        {
            "type": "text",
            "size": "H1",
            "content": "T latch"
        },
        {
            "type": "text",
            "size": "H1",
            "content": "Introduction",
            "scrollToId": 10
        },
        {
            "type": "text",
            "size": "H3",
            "content": "T latch is formed when the inputs of the JK latch are shorted. When the input is high, then the output toggles."
        },
        {
            "type": "text",
            "size": "H1",
            "content": "State table",
