                            "isAnswer": false
                        },
                        {
                            "option": "Triangle",
                            "isAnswer": false
                        }
                    ]
                },
                {
                    "question": "Which shape is represented by an object having exactly 2 variables?",
                    "options": [
                        {
                            "option": "Square",
                            "isAnswer": true
                        },
                        {
                            "option": "Circle",
                            "isAnswer": false
                        },
                        {
                            "option": "Triangle",
                            "isAnswer": false
                        }
                    ]
                },
                {
                    "question": "Which shape is represented by an object having exactly 3 variables?",
                    "options": [
                        {
